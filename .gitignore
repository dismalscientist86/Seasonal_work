# Large data files — do not commit to GitHub
# ============================================================

# Replication package zip (1.8 GB)
replication_package/238636-V1.zip

# Extracted Stata data files — data/qwi_clean/ and data/qcew_clean/ are the
# exceptions: those are derived index CSVs (+ codebooks) meant to ship in
# the public repo, not raw input data.
data/*
!data/qwi_clean/
!data/qcew_clean/
*.dta
*.dta.gz
*.dta.gz.*

# QWI bulk downloads
qwi_raw/

# Any other large or sensitive data files
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle

# Output files (regenerated by code) — figures, tables, and the final slide
# deck ARE synced to GitHub; everything else under output/ (LaTeX build junk,
# any other scratch output) stays local-only.
output/*
!output/figures/
!output/tables/
!output/slides/
output/slides/*
!output/slides/slides.tex
!output/slides/slides.pdf
!output/slides/*.qmd
!output/slides/*.html
models/
logs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter notebooks (checkpoints)
.ipynb_checkpoints/
*.ipynb

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Environment variables / secrets — NEVER commit these
.env
*.env
# (the .env.example template IS committed — that is intentional)

# Stata log files (if any are generated)
*.smcl
*.log
